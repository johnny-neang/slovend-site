# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth 2.0 Web client (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URIs:
#   https://www.slovend.com/api/auth/callback/google
#   https://slovend.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Private-beta allowlist: comma-separated exact emails and/or @domains.
# If empty, ALL sign-ins are denied (fail-safe).
AUTH_ALLOWLIST=@futurenow.co

# Canonical site URL (pins the OAuth callback host in production).
AUTH_URL=https://www.slovend.com

# ---- Per-user secret storage ----
# Encrypts each operator's Lynx token at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Neon Postgres connection string. Auto-set by the Vercel Marketplace Neon
# integration (Project -> Storage -> Create Database -> Neon). When present,
# tokens are saved to the user's profile (encrypted) instead of a cookie.
DATABASE_URL=

# ---- Vercel Blob (manual product images on the Inventory grid) ----
# Stores operator-uploaded product photos. Auto-set when a Blob store is linked
# (Vercel Project -> Storage -> Create -> Blob). Without it, the grid still works
# with placeholders but image upload fails.
BLOB_READ_WRITE_TOKEN=

# ---- Nayax Lynx API ----
# NOT a global credential. Each signed-in operator connects their OWN Lynx token
# from the dashboard ("Connect your Nayax account"). It is encrypted and saved to
# their profile (Neon) — or, until the DB is provisioned, to an httpOnly cookie.
# There is intentionally no NAYAX_* env var.

# ---- Mailjet (early-access / interest form notifications) ----
# The Vendai interest form emails johnny@futurenow.co via the Mailjet Send API.
# Mailjet auth requires BOTH keys (Account -> API Key Management):
#   MAIL_JET        = public API key
#   MAIL_JET_SECRET = private secret key
# Sender noreply@futurenow.co must be a validated sender/domain in Mailjet.
MAIL_JET=
MAIL_JET_SECRET=
